# Café Fausse PostgreSQL (created by scripts/setup-postgres.sh)
DATABASE_URL=postgresql+psycopg://cafe_fausse@127.0.0.1:5433/cafe_fausse
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=cafe_fausse
PGDATABASE=cafe_fausse

# Flask API port (5000 is often used by macOS AirPlay Receiver)
FLASK_PORT=5001

# Docker Compose PostgreSQL (port 5432)
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cafe_fausse
